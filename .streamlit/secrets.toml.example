# Archivo de ejemplo para configuracion de claves de API de los Agentes IA.
# Para usarlo: copie este archivo como .streamlit/secrets.toml y reemplace el valor.
# Nota: .streamlit/secrets.toml esta en .gitignore para proteger sus credenciales.

# Opcion recomendada (Gratuita con modelos Llama 3.3 70B y Llama 3.1 8B):
# Obtenga su clave gratuita en https://console.groq.com/keys
GROQ_API_KEY = "gsk_su_clave_aqui"

# Alternativa Gemini (Google AI Studio):
# Obtenga su clave en https://aistudio.google.com/app/apikey
# GEMINI_API_KEY = "su_clave_gemini_aqui"

# Alternativa OpenRouter:
# OPENROUTER_API_KEY = "su_clave_openrouter_aqui"
